{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content user signin slipway-signin{{if .LinkAccountMode}} icon{{end}}">
	<div class="ui middle very relaxed page grid">
		<div class="column tw-flex tw-flex-col tw-gap-4 tw-max-w-2xl tw-m-auto">
			<div class="slipway-hero">
				<img src="{{AssetUrlPrefix}}/img/logo.svg" width="72" height="72" alt="">
				<h1>Slipway</h1>
				<p>Review AI pull requests, then launch them to GitHub</p>
			</div>
			{{template "user/auth/signin_inner" .}}
		</div>
	</div>
</div>
{{template "base/footer" .}}
